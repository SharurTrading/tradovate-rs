/target

# Local generator/runtime caches.
__pycache__/
*.py[cod]

# Local credentials and operator configuration. Only deliberately synthetic
# examples named `.env.example` may be committed.
.env
.env.*
!.env.example
.direnv/
*.key
*.pem
*.p12
*.pfx

# Provider captures and diagnostic artifacts.
*.har
*.pcap
*.pcapng
*.profraw
lcov.info
coverage/

# Editor and operating-system state.
.DS_Store
.idea/
.vscode/
*.swp
*.swo
